    "flutter:test": "cd conquer_app && flutter test",
    "install:all": "cd backend && npm install && cd ../mobile && npm install"
  },
  "keywords": [
    "conquer",
    "game",
    "gps",
    "territory",
    "react",
    "express"
  ],
