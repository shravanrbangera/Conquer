{
  "name": "conquer-monorepo",
  "version": "1.0.0",
  "description": "CONQUER — Own Your World (Real-World Territory Game)",
  "scripts": {
    "dev": "cd mobile && npm run dev",
    "start": "cd mobile && npm run dev",
    "dev:mobile": "cd mobile && npm run dev",
    "dev:backend": "cd backend && npm start",
    "flutter:run": "cd conquer_app && flutter run",
